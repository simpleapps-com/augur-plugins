// Generated by lsc from cleanup-rules.ts
// lsc options: string-semantics=javascript-utf16

datatype BranchStep = force_delete | safe_delete | keep

function tipIsMergedHead(heads: seq<string>, tip: string): bool
{
  headsHoldFrom(heads, tip, 0)
}

function staysOnBranch(current: string, defaultBranch: string, currentOpenPr: bool): bool
{
  ((current != defaultBranch) && currentOpenPr)
}

function fastForwards(dirty: bool, current: string, defaultBranch: string, currentOpenPr: bool): bool
{
  (!(dirty) && !(staysOnBranch(current, defaultBranch, currentOpenPr)))
}

function switchesToDefault(dirty: bool, current: string, defaultBranch: string, currentOpenPr: bool): bool
{
  (fastForwards(dirty, current, defaultBranch, currentOpenPr) && (current != defaultBranch))
}

function endsOn(dirty: bool, current: string, defaultBranch: string, currentOpenPr: bool): string
{
  if switchesToDefault(dirty, current, defaultBranch, currentOpenPr) then
    defaultBranch
  else
    current
}

function decide(name: string, tip: string, mergedHeads: seq<string>, listedMerged: bool, defaultBranch: string, onBranch: string): BranchStep
{
  if ((name == defaultBranch) || (name == onBranch)) then
    BranchStep.keep
  else
    if tipIsMergedHead(mergedHeads, tip) then
      BranchStep.force_delete
    else
      if listedMerged then
        BranchStep.safe_delete
      else
        BranchStep.keep
}

function branchStep(dirty: bool, name: string, tip: string, mergedHeads: seq<string>, listedMerged: bool, defaultBranch: string, onBranch: string): BranchStep
{
  if dirty then
    BranchStep.keep
  else
    decide(name, tip, mergedHeads, listedMerged, defaultBranch, onBranch)
}

function headsHoldFrom_fun_spec(heads: seq<string>, tip: string, i: nat): bool
  decreases (|heads| - i)
{
  ((i < |heads|) && ((heads[i] == tip) || headsHoldFrom_fun_spec(heads, tip, (i + 1))))
}

function headsHoldFrom(heads: seq<string>, tip: string, i: nat): bool
{
  headsHoldFrom_fun_spec(heads, tip, i)
}
by method {
  var j := i;
  while ((j < |heads|) && (heads[j] != tip))
    invariant (i <= j)
    invariant j <= |heads| || j == i
    invariant headsHoldFrom_fun_spec(heads, tip, j) == headsHoldFrom_fun_spec(heads, tip, i)
    decreases (|heads| - j)
  {
    j := (j + 1);
  }
  return (j < |heads|);
}
