function slugFrom(s: string, i: nat, started: bool, gap: bool): string
  decreases (|s| - i)
{
  if (i >= |s|) then
    ""
  else
    var c := (s[i] as int);
    var keep := (((c >= 97) && (c <= 122)) || isDigitUnit(c));
    if !(keep) then
      slugFrom(s, (i + 1), started, started)
    else
      (((if gap then "-" else "") + s[i..(i + 1)]) + slugFrom(s, (i + 1), true, false))
}

function slug(name: string): string
{
  slugFrom(lower(name), 0, false, false)
}

function hubIdFor(projectName: string, project: string): string
{
  var s := slug(projectName);
  if (s != "") then
    s
  else
    ("basecamp-" + project)
}

function brEnd(s: string, i: nat): int
  requires (i <= |s|)
  ensures ((brEnd(s, i) == -1) || ((i < brEnd(s, i)) && (brEnd(s, i) <= |s|)))
{
  if (((i + 3) > |s|) || (lower(s[i..(i + 3)]) != "<br")) then
    -1
  else
    var j := spaceRunEnd(s, (i + 3));
    var k := (if hasAt(s, j, "/") then (j + 1) else j);
    if hasAt(s, k, ">") then
      (k + 1)
    else
      -1
}

lemma brEnd_ensures(s: string, i: nat)
  requires (i <= |s|)
  ensures ((brEnd(s, i) == -1) || ((i < brEnd(s, i)) && (brEnd(s, i) <= |s|)))
{
}

function plainFrom(s: string, i: nat): string
  requires (i <= |s|)
  decreases (|s| - i)
{
  if (i >= |s|) then
    ""
  else
    var e := brEnd(s, i);
    if (e > 0) then
      ("\u000A" + plainFrom(s, e))
    else
      (s[i..(i + 1)] + plainFrom(s, (i + 1)))
}

function plainText(html: string): string
{
  plainFrom(html, 0)
}
