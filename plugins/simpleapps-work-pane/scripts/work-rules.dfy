function parseGithubId(id: string, org: string): GithubParts
{
  var none := GithubParts(false, "", "", "");
  if !(hasAt(id, 0, "gh-")) then
    none
  else
    var k := lastHyphenBefore(id, |id|);
    if (k <= 3) then
      none
    else
      var digits := id[(k + 1)..|id|];
      var name := id[3..k];
      if (((|digits| == 0) || !(allDigitsFrom(digits, 0))) || !(noLineEndFrom(name, 0))) then
        none
      else
        var dot := firstDotFrom(name, 0);
        if (dot < 0) then
          GithubParts(true, org, name, digits)
        else
          GithubParts(true, name[0..dot], name[(dot + 1)..|name|], digits)
}

