  ensures (afterSeconds(s, p) <= |s|)
{
}

function afterZone(s: string, p: nat): int
  requires (p <= |s|)
{
  if hasAt(s, p, "Z") then
    (p + 1)
  else
    if (!(hasAt(s, p, "+")) && !(hasAt(s, p, "-"))) then
      p
    else
      if !(digitsAt(s, (p + 1), 2)) then
        -1
      else
        var c := (if hasAt(s, (p + 3), ":") then (p + 4) else (p + 3));
        if digitsAt(s, c, 2) then
          (c + 2)
        else
          -1
}

function isWhenText(s: string): bool
{
  if !(isDayPart(s)) then
    false
  else
    ((|s| == 10) || (if (((!(hasAt(s, 10, "T")) || !(digitsAt(s, 11, 2))) || !(hasAt(s, 13, ":"))) || !(digitsAt(s, 14, 2))) then false else (afterZone(s, afterSeconds(s, 16)) == |s|)))
}

