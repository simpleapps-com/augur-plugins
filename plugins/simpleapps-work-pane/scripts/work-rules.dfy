function refContext(isGithub: bool, ref: string, org: string): RefContext
{
  var none := RefContext(false, "", "", org);
  if !(isGithub) then
    none
  else
    var o := repoRunEnd(ref, 0);
    if ((o == 0) || !(hasAt(ref, o, "/"))) then
      none
    else
      var r := repoRunEnd(ref, (o + 1));
      if ((r == (o + 1)) || !(hasAt(ref, r, "#"))) then
        none
      else
        var d := digitRunEnd(ref, (r + 1));
        if ((d == (r + 1)) || (d != |ref|)) then
          none
        else
          RefContext(true, ref[0..o], ref[(o + 1)..r], org)
}

