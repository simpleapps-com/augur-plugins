function formatScalar(text: string): string
{
  var plain := ((((|text| > 0) && !(hasMarkFrom(text, 0))) && !(isSpaceUnit((text[0] as int)))) && !(isSpaceUnit((text[(|text| - 1)] as int))));
  if plain then
    text
  else
    if hasDoubleQuoteFrom(text, 0) then
      (("'" + text) + "'")
    else
      (("\"" + text) + "\"")
}

function formatList(items: seq<string>): string
{
  (("[" + formatItemsFrom(items, 0)) + "]")
}

function parseScalar(raw: string): string
{
  var v := trimText(raw);
  if (|v| < 2) then
    v
  else
    var q := (v[0] as int);
    if (((q != 34) && (q != 39)) || ((v[(|v| - 1)] as int) != q)) then
      v
    else
      var inner := v[1..(|v| - 1)];
      if noLineEndFrom(inner, 0) then
        inner
      else
        v
}

