  var k := refIndex(refs, id, 0);
  if (k < 0) then
    (refs + [Ref(id, closes, project)])
  else
    mergeAt(refs, k, closes, project)
}

function issueRefId(h: Hit, ctx: RefContext): string
{
  if ((h.owner == "") && (lower(h.repo) == "gh")) then
    if ctx.hasRepo then
      numberedId(ctx.owner, ctx.repo, h.num, ctx.org)
    else
      ""
  else
    numberedId((if (h.owner == "") then ctx.org else h.owner), h.repo, h.num, ctx.org)
}

function bareRefId(refs: seq<Ref>, num: string, ctx: RefContext): string
{
  var known := knownIssueId(refs, num, 0);
  if (known != "") then
    known
  else
    if ctx.hasRepo then
      numberedId(ctx.owner, ctx.repo, num, ctx.org)
    else
      ""
}

