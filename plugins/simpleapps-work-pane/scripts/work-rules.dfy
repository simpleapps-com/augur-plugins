}

function matchesFormat(format: string, v: string): bool
{
  (matchesNameFormat(format, v) || matchesValueFormat(format, v))
}

function matchesNameFormat(format: string, v: string): bool
{
  if (format == "id") then
    isIdText(v)
  else
    if (format == "text") then
      hasSolidFrom(v, 0)
    else
      if (format == "alias") then
        isAliasText(v)
      else
        if (format == "watch-repo") then
          isWatchRepoText(v)
        else
          ((format == "repo") && isRepoText(v))
}

function matchesValueFormat(format: string, v: string): bool
{
  if (format == "digits") then
    isDigitText(v)
  else
    if (format == "minutes") then
      isMinutesText(v)
    else
      if (format == "url") then
        (hasAt(v, 0, "http://") || hasAt(v, 0, "https://"))
      else
        if (format == "when") then
          isWhenText(v)
        else
          ((format == "stamp") && isStampText(v))
}

