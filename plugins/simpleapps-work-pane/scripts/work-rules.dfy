function classifyLine(line: string): YamlLine
{
  var s := spaceRunEnd(line, 0);
  if ((s == |line|) || (hasAt(line, s, "#") && noLineEndFrom(line, (s + 1)))) then
    YamlLine(LineKind.blank, "", "")
  else
    var t := itemStart(line);
    if (t >= 0) then
      YamlLine(LineKind.item, "", line[t..|line|])
    else
      var k := keyRunEnd(line, 0);
      if (((k > 0) && hasAt(line, k, ":")) && noLineEndFrom(line, (k + 1))) then
        YamlLine(LineKind.pair, line[0..k], line[(k + 1)..|line|])
      else
        YamlLine(LineKind.bad, "", "")
}

