  decreases (|refs| - i)
  ensures ((refIndex(refs, id, i) == -1) || ((i <= refIndex(refs, id, i)) && (refIndex(refs, id, i) < |refs|)))
{
  if (i >= |refs|) then
    -1
  else
    if (refs[i].id == id) then
      i
    else
      refIndex(refs, id, (i + 1))
}

