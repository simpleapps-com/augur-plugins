function labelFrom(s: string, i: nat): string
  decreases (|s| - i)
{
  if (i >= |s|) then
    ""
  else
    var c := (s[i] as int);
    var head := (if (c == 34) then "#quot;" else (if ((c == 60) || (c == 62)) then "" else s[i..(i + 1)]));
    (head + labelFrom(s, (i + 1)))
}

function chartLabel(text: string): string
{
  labelFrom(text, 0)
}

