{
  ((((((((keywordEndsAt(s, lo, e, "close") || keywordEndsAt(s, lo, e, "closes")) || keywordEndsAt(s, lo, e, "closed")) || keywordEndsAt(s, lo, e, "fix")) || keywordEndsAt(s, lo, e, "fixes")) || keywordEndsAt(s, lo, e, "fixed")) || keywordEndsAt(s, lo, e, "resolve")) || keywordEndsAt(s, lo, e, "resolves")) || keywordEndsAt(s, lo, e, "resolved"))
