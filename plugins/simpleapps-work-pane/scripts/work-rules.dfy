  ensures (p <= afterSeconds(s, p))
  ensures (afterSeconds(s, p) <= |s|)
{
  if (!(hasAt(s, p, ":")) || !(digitsAt(s, (p + 1), 2))) then
    p
  else
    var q := (p + 3);
    if !(hasAt(s, q, ".")) then
      q
    else
      var d := digitRunEnd(s, (q + 1));
      if (d > (q + 1)) then
        d
      else
        q
}

