  requires (i <= |s|)
  decreases (|s| - i)
{
  if (i >= |s|) then
    ""
  else
    var c := (s[i] as int);
    if isSpaceUnit(c) then
      (" " + briefCellFrom(s, spaceRunEnd(s, i)))
    else
      ((if (c == 124) then "\\|" else s[i..(i + 1)]) + briefCellFrom(s, (i + 1)))
}

