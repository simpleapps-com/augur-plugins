  else
    if (i >= |b|) then
      1
    else
      var x := (a[i] as int);
      var y := (b[i] as int);
      if (x != y) then
        if (x < y) then
          -1
        else
          1
      else
        compareFrom(a, b, (i + 1))
}

function laterText(a: string, b: string): string
{
  if (compareText(a, b) < 0) then
    b
  else
