}

function occursIn(s: string, w: string, i: nat): bool
  decreases (|s| - i)
{
  if ((i + |w|) > |s|) then
    false
  else
    ((s[i..(i + |w|)] == w) || occursIn(s, w, (i + 1)))
}

function movedAway(htmlUrl: string, org: string, repo: string): bool
{
  !(occursIn(lower(htmlUrl), lower((((("/" + org) + "/") + repo) + "/issues/")), 0))
}

