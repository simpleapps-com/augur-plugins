function isMinutesText(s: string): bool
{
  if (|s| == 1) then
    (((s[0] as int) >= 49) && ((s[0] as int) <= 57))
  else
    if (|s| != 2) then
      false
    else
      var a := (s[0] as int);
      var b := (s[1] as int);
      ((((a >= 49) && (a <= 53)) && isDigitUnit(b)) || ((a == 54) && (b == 48)))
}

function isDayPart(s: string): bool
{
  ((((digitsAt(s, 0, 4) && hasAt(s, 4, "-")) && digitsAt(s, 5, 2)) && hasAt(s, 7, "-")) && digitsAt(s, 8, 2))
}

