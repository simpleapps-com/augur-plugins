{
  var a := scanGithubUrls(s, 0, ctx, []);
  var b := scanIssueRefs(s, 0, ctx, a);
  var c := scanBareRefs(s, 0, ctx, b);
  var d := scanBasecampUrls(s, 0, c);
  scanBcRefs(s, 0, d)
}

