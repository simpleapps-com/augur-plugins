function parseValue(raw: string): YamlValue
{
  var v := trimText(raw);
  if (((|v| < 2) || ((v[0] as int) != 91)) || ((v[(|v| - 1)] as int) != 93)) then
    YamlValue(false, parseScalar(v), [])
  else
    var inner := trimText(v[1..(|v| - 1)]);
    if (|inner| == 0) then
      YamlValue(true, "", [])
    else
      YamlValue(true, "", splitItemsFrom(inner, 0))
}

