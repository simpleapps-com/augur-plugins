    var j := spaceRunEnd(line, (i + 1));
    if (j == (i + 1)) then
      -1
    else
      if (j < |line|) then
        if noLineEndFrom(line, j) then
          j
        else
          -1
      else
        if (((j - 1) >= (i + 2)) && !(isLineEndUnit((line[(j - 1)] as int)))) then
          (j - 1)
        else
          -1
}

