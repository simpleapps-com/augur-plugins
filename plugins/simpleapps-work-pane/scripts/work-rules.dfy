function scalarProblem(isList: bool, v: string, hasEnum: bool, allowed: seq<string>, format: string): string
{
  if (isList || (|v| == 0)) then
    "empty"
  else
    if (hasEnum && !(holds(allowed, v))) then
      "enum"
    else
      if ((format != "") && !(matchesFormat(format, v))) then
        "format"
      else
        ""
}

