function projectInUrlFrom(url: string, i: nat): string
  requires (i <= |url|)
  decreases (|url| - i)
{
  if (i >= |url|) then
    ""
  else
    if hasAt(url, i, "/projects/") then
      var d := digitRunEnd(url, (i + 10));
      if ((d > (i + 10)) && hasAt(url, d, "/")) then
        url[(i + 10)..d]
      else
        projectInUrlFrom(url, (i + 1))
    else
      projectInUrlFrom(url, (i + 1))
}

