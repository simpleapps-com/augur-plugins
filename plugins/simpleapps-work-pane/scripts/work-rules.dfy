      var r := repoRunEnd(ref, (o + 1));
      if ((r == (o + 1)) || !(hasAt(ref, r, "#"))) then
        none
      else
        var d := digitRunEnd(ref, (r + 1));
        if ((d == (r + 1)) || (d != |ref|)) then
          none
        else
          RefContext(true, ref[0..o], ref[(o + 1)..r], org)
