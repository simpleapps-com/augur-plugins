function isAliasText(s: string): bool
{
  var e := equalsAt(s, 0);
  (((equalsFrom(s, 0) == 1) && (e > 0)) && ((e + 1) < |s|))
}

function isWatchRepoText(s: string): bool
{
  var a := repoRunEnd(s, 0);
  if (a == 0) then
    false
  else
    ((a == |s|) || (if !(hasAt(s, a, "/")) then false else (var b := repoRunEnd(s, (a + 1)); ((b > (a + 1)) && (b == |s|)))))
}

