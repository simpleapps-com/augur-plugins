function countColour(known: bool, open: int, complete: bool): Colour
{
  if !(known) then
    Colour.plain
  else
    if (open > 10) then
      Colour.red
    else
      if ((open == 0) && complete) then
        Colour.green
      else
        Colour.plain
}

