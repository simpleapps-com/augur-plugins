    result
  else
    PaneSync(result.at, false, (((result.detail + ", GitHub only; Basecamp skipped (") + problem) + ")"))
}

function withBriefProblem(result: PaneSync, hasProblem: bool, problem: string): PaneSync
{
  if !(notesBriefProblem(result.ok, hasProblem)) then
    result
  else
    PaneSync(result.at, result.ok, (((result.detail + "; briefs kept their last Basecamp read (") + problem) + ")"))
}

const BASECAMP_ORIGIN: string := "https://basecamp.augur-mcp.com"

function paneRunEnd_fun_spec(s: string, i: nat, ok: (int) -> bool): int
  requires (i <= |s|)
  ensures i <= paneRunEnd_fun_spec(s, i, ok) <= |s|
  decreases |s| - i
{
  // What the loop computes: the first index from i whose code unit fails ok, or the end.
  if i == |s| || !ok(s[i] as int) then i else paneRunEnd_fun_spec(s, i + 1, ok)
}

function paneRunEnd(s: string, i: nat, ok: (int) -> bool): int
  requires (i <= |s|)
  ensures i <= paneRunEnd(s, i, ok) <= |s|
{
  paneRunEnd_fun_spec(s, i, ok)
}
by method {
  var j := i;
  while ((j < |s|) && ok((s[j] as int)))
    invariant (i <= j)
    invariant (j <= |s|)
    invariant paneRunEnd_fun_spec(s, j, ok) == paneRunEnd_fun_spec(s, i, ok)
    decreases (|s| - j)
  {
    j := (j + 1);
  }
  return j;
}

function paneRunStart_fun_spec(s: string, lo: nat, e: nat, ok: (int) -> bool): int
  requires (lo <= e)
  requires (e <= |s|)
  ensures lo <= paneRunStart_fun_spec(s, lo, e, ok) <= e
  decreases e - lo
{
  // What the loop computes: the lowest j from e down to lo with every code unit in [j, e) passing.
  if e == lo || !ok(s[e - 1] as int) then e else paneRunStart_fun_spec(s, lo, e - 1, ok)
}

function paneRunStart(s: string, lo: nat, e: nat, ok: (int) -> bool): int
  requires (lo <= e)
  requires (e <= |s|)
  ensures lo <= paneRunStart(s, lo, e, ok) <= e
{
  paneRunStart_fun_spec(s, lo, e, ok)
}
by method {
  var j := e;
  while ((j > lo) && ok((s[(j - 1)] as int)))
    invariant (lo <= j)
    invariant (j <= e)
    invariant paneRunStart_fun_spec(s, lo, j, ok) == paneRunStart_fun_spec(s, lo, e, ok)
    decreases (j - lo)
  {
    j := (j - 1);
  }
  return j;
}

function paneListEnd_fun_spec<T>(xs: seq<T>, i: nat, ok: (T) -> bool): int
  requires (i <= |xs|)
  ensures i <= paneListEnd_fun_spec(xs, i, ok) <= |xs|
  decreases |xs| - i
{
  // What the loop computes: the first index from i whose element fails ok, or the end.
  if i == |xs| || !ok(xs[i]) then i else paneListEnd_fun_spec(xs, i + 1, ok)
}

