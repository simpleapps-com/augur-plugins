function wtHasPrefix(s: string, p: string): bool
{
  ((|p| <= |s|) && (s[0..|p|] == p))
}

function isNameStartUnit(c: int): bool
{
  ((((c >= 65) && (c <= 90)) || ((c >= 97) && (c <= 122))) || ((c >= 48) && (c <= 57)))
}

function isNameUnit(c: int): bool
{
  (((isNameStartUnit(c) || (c == 46)) || (c == 95)) || (c == 45))
}

function isWorktreeName(s: string): bool
{
  ((((|s| > 0) && isNameStartUnit((s[0] as int))) && (wtRunEnd(s, 1, isNameUnit) == |s|)) && !(dotPairFrom(s, 0)))
}

