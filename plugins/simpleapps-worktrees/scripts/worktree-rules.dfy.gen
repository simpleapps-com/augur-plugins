}

function isShellSafeUnit(c: int): bool
{
  var quoting := (((c != 34) && (c != 37)) && (c != 33));
  var operators := (((((c != 38) && (c != 124)) && (c != 60)) && (c != 62)) && (c != 94));
  (((quoting && operators) && (c != 10)) && (c != 13))
}

