datatype Layout = own_repo | project_repo | enclosing_repo | no_repo

datatype BaseMode = from_remote | from_head

datatype CreateStep = bad_name | no_layout | refuse | re_enter | add_new

datatype Held = unreadable | uncommitted | unpushed | on_branch | no_work

