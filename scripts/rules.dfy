// Generated by lsc from rules.ts
// lsc options: string-semantics=javascript-utf16

datatype Budget = fits | near | over

function isDigitCode(c: int): bool
{
  ((c >= 48) && (c <= 57))
}

lemma isDigitCode_ensures(c: int)
  ensures (isDigitCode(c) <==> ((c >= 48) && (c <= 57)))
{
}

function isLowerCode(c: int): bool
{
  ((c >= 97) && (c <= 122))
}

lemma isLowerCode_ensures(c: int)
  ensures (isLowerCode(c) <==> ((c >= 97) && (c <= 122)))
{
}

function isNameCode(c: int): bool
{
  ((isLowerCode(c) || isDigitCode(c)) || (c == 45))
}

lemma isNameCode_ensures(c: int)
  ensures (isNameCode(c) <==> ((((c >= 97) && (c <= 122)) || ((c >= 48) && (c <= 57))) || (c == 45)))
{
}

function isNonSpaceCode(c: int): bool
{
  (c != 32)
}

lemma isNonSpaceCode_ensures(c: int)
  ensures (isNonSpaceCode(c) <==> (c != 32))
{
}

function yearPart(s: string): bool
  requires (|s| >= 8)
{
  var first := (s[0] as int);
  ((((first >= 49) && (first <= 57)) && (scanEnd(s, 1, isDigitCode) >= 4)) && ((s[4] as int) == 46))
}

function seqFrom(s: string, a: nat): bool
  requires (a < |s|)
{
  var first := (s[a] as int);
  (((first >= 49) && (first <= 57)) && (scanEnd(s, (a + 1), isDigitCode) == |s|))
}

function shortMonth(s: string): bool
  requires (|s| >= 8)
{
  var m := (s[5] as int);
  (((((s[6] as int) == 46) && (m >= 49)) && (m <= 57)) && seqFrom(s, 7))
}

function longMonth(s: string): bool
  requires (|s| >= 8)
{
  if (((|s| < 9) || ((s[7] as int) != 46)) || ((s[5] as int) != 49)) then
    false
  else
    var m := (s[6] as int);
    (((m >= 48) && (m <= 50)) && seqFrom(s, 8))
}

function isCalVer(s: string): bool
{
  (((|s| >= 8) && yearPart(s)) && (shortMonth(s) || longMonth(s)))
}

function isSkillKey(k: string): bool
{
  ((((((k == "name") || (k == "description")) || (k == "license")) || (k == "compatibility")) || (k == "metadata")) || (k == "allowed-tools"))
}

lemma isSkillKey_ensures(k: string)
  ensures (isSkillKey(k) <==> ((((((k == "name") || (k == "description")) || (k == "license")) || (k == "compatibility")) || (k == "metadata")) || (k == "allowed-tools")))
{
}

function isSkillName(n: string): bool
{
  ((((|n| >= 1) && (|n| <= 64)) && isLowerCode((n[0] as int))) && (scanEnd(n, 1, isNameCode) == |n|))
}

function isReservedName(n: string): bool
{
  (occursFrom(n, "anthropic", 0) || occursFrom(n, "claude", 0))
}

function hasHelpSection(text: string): bool
{
  occursFrom(text, "<!-- shared:help -->\u000A## Help\u000A", 0)
}

function hintListsHelp(hint: string): bool
{
  (occursFrom(hint, " | help]", 0) || occursFrom(hint, "[help]", 0))
}

function sameDescription(command: string, skill: string): bool
{
  (command == skill)
}

lemma sameDescription_ensures(command: string, skill: string)
  ensures (sameDescription(command, skill) <==> (command == skill))
{
}

function descriptionFits(length: nat): bool
  requires (length >= 0)
{
  (length <= 1024)
}

lemma descriptionFits_ensures(length: nat)
  requires (length >= 0)
  ensures (descriptionFits(length) <==> (length <= 1024))
{
}

function budgetOf(words: nat): Budget
  requires (words >= 0)
{
  if (words > 3750) then
    Budget.over
  else
    if (words > 3375) then
      Budget.near
    else
      Budget.fits
}

function isAugurUrl(u: string): bool
{
  if ((|u| < 8) || (u[0..8] != "https://")) then
    false
  else
    var j := scanEnd(u, 8, isNameCode);
    (((j > 8) && ((j + 15) <= |u|)) && (u[j..(j + 15)] == ".augur-mcp.com/"))
}

function isVendorUrl(u: string): bool
{
  ((|u| >= 24) && (u[0..24] == "https://mcp.semrush.com/"))
}

function isConnectorUrl(u: string): bool
{
  (isAugurUrl(u) || isVendorUrl(u))
}

function isSecretKey(k: string): bool
{
  ((k == "licenceKey") || (k == "licenseKey"))
}

lemma isSecretKey_ensures(k: string)
  ensures (isSecretKey(k) <==> ((k == "licenceKey") || (k == "licenseKey")))
{
}

function isLspCommand(c: string): bool
{
  ((|c| > 0) && (((c[0] as int) == 47) || (scanEnd(c, 0, isNonSpaceCode) == |c|)))
}

function scanEnd_fun_spec(s: string, i: nat, ok: (int) -> bool): int
  requires (i <= |s|)
  decreases |s| - i
{
  // What the loop computes: the first index from i whose code unit fails ok, or the end.
  if i == |s| || !ok(s[i] as int) then i else scanEnd_fun_spec(s, i + 1, ok)
}

function scanEnd(s: string, i: nat, ok: (int) -> bool): int
  requires (i <= |s|)
{
  scanEnd_fun_spec(s, i, ok)
}
by method {
  var j := i;
  while ((j < |s|) && ok((s[j] as int)))
    invariant (i <= j)
    invariant (j <= |s|)
    invariant scanEnd_fun_spec(s, j, ok) == scanEnd_fun_spec(s, i, ok)
    decreases (|s| - j)
  {
    j := (j + 1);
  }
  return j;
}

function occursFrom_fun_spec(s: string, w: string, i: nat): bool
  requires (i >= 0)
  decreases |s| - i
{
  // What the loop computes: w at i, or at a later index.
  if i + |w| > |s| then false else s[i..i + |w|] == w || occursFrom_fun_spec(s, w, i + 1)
}

function occursFrom(s: string, w: string, i: nat): bool
  requires (i >= 0)
{
  occursFrom_fun_spec(s, w, i)
}
by method {
  var j := i;
  while (((j + |w|) <= |s|) && (s[j..(j + |w|)] != w))
    invariant (i <= j)
    invariant occursFrom_fun_spec(s, w, j) == occursFrom_fun_spec(s, w, i)
    decreases (|s| - j)
  {
    j := (j + 1);
  }
  return ((j + |w|) <= |s|);
}
