    invariant (i <= j)
    invariant j <= |s| || j == i
    invariant digitsFrom_fun_spec(s, j) == digitsFrom_fun_spec(s, i)
    decreases (|s| - j)
  {
    j := (j + 1);
  }
  return (j >= |s|);
}

